musiclove-label.ru {
	encode zstd gzip

	request_body {
		max_size 510MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	reverse_proxy app:3000

	log {
		output stdout
		format console
	}
}

www.musiclove-label.ru {
	redir https://musiclove-label.ru{uri} permanent
}
