# Set these values in Netlify, never commit real credentials.
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32

TURSO_CONNECTION_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_DATABASE_TOKEN

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY

STORAGE_DRIVER=supabase
NEXT_PUBLIC_STORAGE_DRIVER=supabase-direct
NEXT_PUBLIC_APP_URL=https://YOUR_SITE.netlify.app

# Required only for new-registration email codes.
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Music Love

# Optional integrations.
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
